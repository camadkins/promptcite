{
  "name": "promptcite",
  "version": "2.0.0",
  "description": "Cross-agent skill that adds /receipt — a structured AI-use disclosure command for student assignments",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "bin/install.js",
  "bin": {
    "promptcite": "bin/install.js",
    "promptcite-verify": "bin/verify.js",
    "promptcite-hook": "bin/hook.js",
    "promptcite-check": "bin/check.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camadkins/promptcite.git"
  },
  "homepage": "https://github.com/camadkins/promptcite",
  "bugs": {
    "url": "https://github.com/camadkins/promptcite/issues"
  },
  "keywords": [
    "ai",
    "education",
    "academic-integrity",
    "disclosure",
    "citation",
    "claude-code",
    "gemini-cli",
    "cursor",
    "skill"
  ],
  "files": [
    "bin/",
    "src/",
    "LICENSE",
    "LICENSE-COMMERCIAL",
    "NOTICE.md",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "node bin/install.js",
    "list": "node bin/install.js --list",
    "dry-run": "node bin/install.js --dry-run --all",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node bin/install.js --version && node bin/install.js --list && node bin/install.js --help && node bin/install.js --dry-run --all && node bin/check.js --help",
    "test": "node --test tests/*.test.js",
    "rule:check": "node bin/rule.js --check",
    "rule:gemini": "node bin/rule.js --write-gemini"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
